/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Nome com hash de conteúdo: uma fonte nova é um arquivo novo, então o cache pode ser eterno.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Bundle do Astro, também nomeado por hash.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Nome estável: o arquivo pode ser trocado no lugar, então o cache é longo mas revalidável.
/shots/*
  Cache-Control: public, max-age=604800
/brand/*
  Cache-Control: public, max-age=604800
/profile/*
  Cache-Control: public, max-age=604800

# O wordmark entra pelo CSS de todas as páginas (--wm) e mora na raiz por causa disso.
/wordmark-viktus.png
  Cache-Control: public, max-age=604800
