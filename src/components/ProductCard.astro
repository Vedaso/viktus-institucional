---
interface Props {
  name: string;
  tagline: string;
  description: string;
  url: string;
  status: 'producao' | 'desenvolvimento' | 'em-breve';
  ctaLabel: string;
}

const { name, tagline, description, url, status, ctaLabel } = Astro.props;

const badgeText = {
  producao: 'Em produção',
  desenvolvimento: 'Em desenvolvimento',
  'em-breve': 'Em breve',
}[status];
---

<article class={`card card--${status}`}>
  <div class="card-header">
    <h3>{name}</h3>
    <span class={`badge badge--${status}`}>{badgeText}</span>
  </div>
  <p class="tagline">{tagline}</p>
  <p class="description">{description}</p>
  {status === 'producao' ? (
    <a href={url} target="_blank" rel="noopener noreferrer" class="cta">{ctaLabel} →</a>
  ) : status === 'desenvolvimento' ? (
    <a href={url} target="_blank" rel="noopener noreferrer" class="cta cta--muted">{ctaLabel}</a>
  ) : (
    <span class="cta cta--disabled">{ctaLabel}</span>
  )}
</article>

<style>
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: background 0.15s;
  }
  .card:hover { background: var(--color-surface-hover); }

  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  h3 { font-size: 1.15rem; font-weight: 700; }

  .badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .badge--producao {
    background: var(--badge-producao-bg);
    border: 1px solid var(--badge-producao-border);
    color: var(--badge-producao-text);
  }
  .badge--desenvolvimento {
    background: var(--badge-desenvolvimento-bg);
    border: 1px solid var(--badge-desenvolvimento-border);
    color: var(--badge-desenvolvimento-text);
  }
  .badge--em-breve {
    background: var(--badge-embreve-bg);
    border: 1px solid var(--badge-embreve-border);
    color: var(--badge-embreve-text);
  }

  .tagline { font-size: 0.9rem; font-weight: 600; color: var(--color-text-muted); }
  .description { font-size: 0.875rem; line-height: 1.6; color: var(--color-text-muted); flex: 1; }

  .cta {
    display: inline-block;
    margin-top: var(--space-2);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-link);
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .cta:hover { opacity: 0.8; }
  .cta--muted { color: var(--color-text-muted); }
  .cta--disabled { color: var(--color-text-faint); cursor: default; }
</style>
