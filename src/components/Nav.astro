---
const currentPath = Astro.url.pathname;
---

<nav>
  <div class="nav-inner">
    <a href="/" class="logo">Viktus</a>
    <ul>
      <li><a href="/sobre" class={currentPath === '/sobre/' || currentPath === '/sobre' ? 'active' : ''}>Sobre</a></li>
      <li><a href="/contato" class={currentPath === '/contato/' || currentPath === '/contato' ? 'active' : ''}>Contato</a></li>
    </ul>
  </div>
</nav>

<style>
  nav {
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .nav-inner {
    max-width: var(--max-width-wide);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.03em;
  }
  ul {
    list-style: none;
    display: flex;
    gap: var(--space-6);
  }
  a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.15s;
  }
  a:hover, a.active { color: var(--color-text); }
</style>
