---
const currentPath = Astro.url.pathname;
---

<nav>
  <div class="nav-inner">
    <a href="/" class="logo" aria-label="Grupo Viktus — início">
      <img src="/brand/wordmark-viktus.png" alt="Viktus" />
    </a>
    <ul>
      <li><a href="/sobre" class={currentPath === '/sobre/' || currentPath === '/sobre' ? 'active' : ''}>Sobre</a></li>
      <li><a href="/contato" class={currentPath === '/contato/' || currentPath === '/contato' ? 'active' : ''}>Contato</a></li>
    </ul>
  </div>
</nav>

<style>
  nav {
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .nav-inner {
    max-width: var(--max-width-wide);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo img {
    display: block;
    height: 28px;
    width: auto;
    object-fit: contain;
  }
  ul {
    list-style: none;
    display: flex;
    gap: var(--space-6);
  }
  a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    transition: color 0.15s;
  }
  a:hover, a.active { color: var(--color-text); }
</style>
