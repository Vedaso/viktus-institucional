---
interface Props {
  name: string;
  tagline: string;
  description: string;
  url: string;
  status: 'producao' | 'ativo' | 'piloto' | 'desenvolvimento' | 'em-breve';
  ctaLabel: string;
  accent?: string;
  icon?: string;
  descriptor?: string;
  featured?: boolean;
}

const {
  name, tagline, description, url, status, ctaLabel,
  accent, icon, descriptor, featured = false,
} = Astro.props;

// 'ativo' = sistema rodando sem rotulação de fase (não exibe badge).
// 'piloto' = rodando com clientes selecionados em validação de campo.
// 'producao' (legado): rotulação explícita, mantido pra compat.
const badgeText: Record<Props['status'], string | null> = {
  producao: 'Em produção',
  ativo: null,
  piloto: 'Em piloto',
  desenvolvimento: 'Em desenvolvimento',
  'em-breve': 'Em breve',
};

const clickable = status === 'producao' || status === 'ativo' || status === 'piloto';
const badge = badgeText[status];
const Tag = clickable ? 'a' : 'div';
---

<Tag
  class:list={['cell', `cell--${status}`, { 'cell--featured': featured }]}
  style={accent ? `--cell-accent: ${accent}` : ''}
  {...clickable ? { href: url, target: '_blank', rel: 'noopener noreferrer' } : {}}
  aria-label={clickable ? `${name}, ${ctaLabel.toLowerCase()}` : undefined}
>
  <div class="head">
    <!-- Lockup composto do manual: icon + wordmark + descriptor. -->
    <div class="lockup">
      {icon && <img src={icon} alt="" class="lockup-icon" aria-hidden="true" />}
      <div class="lockup-stack">
        <img src="/brand/wordmark-viktus.png" alt="Viktus" class="lockup-wm" />
        {descriptor && <span class="lockup-desc">{descriptor}</span>}
      </div>
    </div>
    {badge && <span class={`badge badge--${status}`}>{badge}</span>}
  </div>

  <div class="body">
    <p class="tagline">{tagline}</p>
    {featured && <p class="description">{description}</p>}
  </div>

  <span class="cta">
    {ctaLabel}
    <span class="arrow" aria-hidden="true">→</span>
  </span>
</Tag>

<style>
  .cell {
    --cell-accent: var(--bone);
    position: relative;
    overflow: hidden;
    background: var(--color-bg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    text-decoration: none;
    color: inherit;
    transition: background var(--dur-base) var(--ease);
  }

  /* O accent do produto banha a célula no hover, em vez de virar
     uma barra lateral. Fica atrás do conteúdo. */
  .cell::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, var(--cell-accent) 0%, transparent 62%);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease);
    pointer-events: none;
  }
  /* O accent do Finanças é o Navy, que sobre o Deep é quase invisível:
     o produto principal ficaria com o hover mais fraco dos três. Clarear
     com um pouco de Bone preserva o matiz de cada produto e iguala a
     intensidade. Onde não houver color-mix, vale a regra acima. */
  @supports (background: color-mix(in oklab, red, blue)) {
    .cell::after {
      background: linear-gradient(
        115deg,
        color-mix(in oklab, var(--cell-accent) 62%, var(--bone)) 0%,
        transparent 64%
      );
    }
  }
  .cell > * { position: relative; z-index: 1; }

  a.cell:hover::after,
  a.cell:focus-visible::after { opacity: 0.3; }
  a.cell:hover { background: var(--color-surface); }

  .cell--featured { gap: var(--space-8); justify-content: space-between; }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .lockup { display: flex; align-items: center; gap: 12px; }
  .lockup-icon {
    height: 44px;
    width: 44px;
    object-fit: contain;
    flex-shrink: 0;
    transition: transform var(--dur-base) var(--ease);
  }
  .cell--featured .lockup-icon { height: 60px; width: 60px; }
  a.cell:hover .lockup-icon { transform: translateY(-2px); }

  .lockup-stack { display: flex; flex-direction: column; gap: 4px; }
  .lockup-wm { height: 17px; width: auto; max-width: 78px; object-fit: contain; }
  .cell--featured .lockup-wm { height: 22px; max-width: 100px; }
  .lockup-desc {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--color-text);
    line-height: 1;
  }
  .cell--featured .lockup-desc { font-size: 0.82rem; }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .badge--producao {
    background: var(--badge-producao-bg);
    border: 1px solid var(--badge-producao-border);
    color: var(--badge-producao-text);
  }
  .badge--piloto {
    background: rgba(201, 169, 97, 0.16);
    border: 1px solid rgba(201, 169, 97, 0.45);
    color: oklch(0.82 0.08 80);
  }
  .badge--desenvolvimento {
    background: var(--badge-desenvolvimento-bg);
    border: 1px solid var(--badge-desenvolvimento-border);
    color: var(--badge-desenvolvimento-text);
  }
  .badge--em-breve {
    background: var(--badge-embreve-bg);
    border: 1px solid var(--badge-embreve-border);
    color: var(--badge-embreve-text);
  }

  .body { display: flex; flex-direction: column; gap: var(--space-3); }

  .tagline {
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-text);
    max-width: 22ch;
    text-wrap: balance;
  }
  .cell--featured .tagline { font-size: 1.75rem; max-width: 16ch; }

  .description {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 46ch;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    /* muted, não faint: faint sobre o Deep dá 3.2:1 e reprova AA
       num texto de 0.78rem. */
    color: var(--color-text-muted);
    transition: color var(--dur-base) var(--ease), gap var(--dur-base) var(--ease);
  }
  a.cell:hover .cta,
  a.cell:focus-visible .cta { color: var(--color-text); gap: var(--space-4); }
  div.cell .cta { color: var(--color-text-faint); }

  @media (max-width: 720px) {
    .cell { padding: var(--space-6); }
    .cell--featured .tagline { font-size: 1.35rem; }
    .cell--featured .lockup-icon { height: 48px; width: 48px; }
  }
</style>
