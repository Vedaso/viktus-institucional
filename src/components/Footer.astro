---
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <p class="company">
      Guri Grupo de Urgência e Recuperação Infantil Ltda<br />
      CNPJ 12.181.962/0001-73 — Maceió, AL
    </p>
    <nav>
      <a href="/privacidade">Privacidade</a>
      <a href="/termos">Termos</a>
      <a href="/contato">Contato</a>
    </nav>
    <p class="copy">© {year} Grupo Viktus</p>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--space-24);
    padding: var(--space-8) var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .footer-inner {
    max-width: var(--max-width-wide);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }
  .company { font-size: 0.8rem; color: var(--color-text-faint); line-height: 1.6; }
  nav { display: flex; gap: var(--space-6); }
  nav a { font-size: 0.85rem; color: var(--color-text-muted); text-decoration: none; }
  nav a:hover { color: var(--color-text); }
  .copy { font-size: 0.75rem; color: var(--color-text-faint); }
</style>
