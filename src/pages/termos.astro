    .js .rv:nth-child(3){ transition-delay:.12s }
    .js .rv:nth-child(4){ transition-delay:.18s }

    /* o hero está na tela quando a página abre: entra sozinho, sem esperar scroll */
    .js .hero h1, .js .hero .lede, .js .hero__acts, .js .hero .stats {
      animation:surge .72s cubic-bezier(.22,.61,.36,1) both }
    .js .hero .lede { animation-delay:.07s }
    .js .hero__acts { animation-delay:.14s }
    .js .hero .stats{ animation-delay:.21s }
    @keyframes surge { from{transform:translateY(18px)} to{transform:none} }

    /* a imagem respira ao entrar: dá profundidade sem parallax e sem custo de layout */
    .js .piece__shot { transition:transform .9s cubic-bezier(.22,.61,.36,1) }
    .js .rv:not(.in) .piece__shot { transform:scale(.972) }
  }

