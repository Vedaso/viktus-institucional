<style is:global is:global>
  /* Tipografia embutida: a pagina nao depende de rede nem do Google. */
  @font-face{font-family:"Bricolage Grotesque";font-style:normal;font-weight:200 800;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
  @font-face{font-family:"Inter";font-style:normal;font-weight:100 900;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
  :root{
    --ink:#050714;
    --ink-2:#090c1c;
    --card:#0E1330;
    --card-2:#151b3d;
    --line:rgba(255,255,255,.09);
    --line-2:rgba(255,255,255,.17);
    --bone:#f4f1eb;
    --mute:#adaaa3;
    --mute-2:#96938c;
    --accent:#F2EEE3;
    --shell:min(1240px,100%);
    --pad:clamp(18px,5vw,44px);
    --display:"Bricolage Grotesque","Segoe UI Variable Display","Segoe UI",system-ui,sans-serif;
    --text:"Inter","Segoe UI",system-ui,sans-serif;
    --wm:url("data:image/png;base64,");
  }
  *,*::before,*::after{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  body{
    margin:0;
    background:var(--ink);
    color:var(--bone);
    font-family:var(--text);
    font-size:16px;
    line-height:1.6;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;display:block}
  a{color:inherit}
  h1,h2,h3{font-family:var(--display);font-weight:600;letter-spacing:-.028em;line-height:1.03;margin:0}
  p{margin:0}

  .shell{width:var(--shell);margin-inline:auto;padding-inline:var(--pad)}
  .eyebrow{
    font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;
    color:var(--accent);font-weight:600;font-family:var(--text);
  }
  .skip{
    position:absolute;left:-9999px;top:0;background:var(--bone);color:var(--ink);
    padding:14px 18px;border-radius:0 0 10px 0;z-index:99;font-weight:600;
  }
  .skip:focus{left:0}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:6px}

  .wordmark{
    display:block;background:var(--wm) left center/contain no-repeat;
    width:73px;height:22px;
  }

  /* ---------- header ---------- */
  .top{
    position:sticky;top:0;z-index:40;
    background:rgba(5,7,20,.82);
    backdrop-filter:blur(14px);
    border-bottom:1px solid var(--line);
  }
  .top__in{
    display:flex;align-items:center;justify-content:space-between;gap:10px;
    min-height:64px;
  }
  .top__mark{display:inline-flex;align-items:center;min-height:44px;padding-right:6px}
  .nav{display:flex;align-items:center;gap:2px}
  .nav a{
    display:inline-flex;align-items:center;justify-content:center;
    min-height:44px;min-width:44px;padding:10px 12px;border-radius:10px;
    font-size:.85rem;font-weight:500;color:var(--mute);text-decoration:none;
  }
  .nav a:hover,.nav a:focus-visible{color:var(--bone);background:rgba(255,255,255,.07)}
  /* telas muito estreitas (320px, ou 390px com zoom de texto): o header precisa caber */
  @media (max-width:400px){
    .top__in{gap:4px}
    .wordmark{width:60px;height:18px}
    .nav{
      gap:0;
      overflow-x:auto;overflow-y:hidden;
      scrollbar-width:none;-ms-overflow-style:none;
      padding-block:4px;margin-block:-4px;
    }
    .nav::-webkit-scrollbar{display:none}
    .nav a{padding:10px 8px;font-size:.8rem}
  }

  /* ---------- hero ---------- */
  .hero{padding:clamp(52px,9.5vw,104px) 0 clamp(44px,7vw,80px);position:relative;overflow:hidden}
  .hero::before{
    content:"";position:absolute;inset:-40% -10% auto -20%;height:130%;
    background:radial-gradient(46% 44% at 26% 30%,rgba(46,60,140,.20),transparent 68%),
               radial-gradient(42% 40% at 82% 18%,rgba(96,120,190,.15),transparent 70%);
    pointer-events:none;
  }
  .hero__in{position:relative;display:grid;gap:clamp(38px,5vw,64px)}
  @media (min-width:1000px){
    .hero__in{grid-template-columns:minmax(0,1.42fr) minmax(0,.58fr);align-items:end;gap:clamp(40px,5vw,72px)}
  }
  .hero h1{
    font-size:clamp(2.5rem,7.4vw,4.7rem);
    font-weight:700;
    max-width:14ch;
    margin:18px 0 0;
    text-wrap:balance;
  }
  .hero h1 em{font-style:normal;color:var(--accent)}
  .lede{
    margin-top:22px;max-width:50ch;
    font-size:clamp(1.02rem,2.1vw,1.24rem);
    color:var(--mute);
  }
  .hero__acts{
    display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;margin-top:30px;
  }
  .ghost{
    display:inline-flex;align-items:center;gap:9px;
    min-height:44px;padding:0 2px;
    font-size:.95rem;font-weight:600;color:var(--bone);text-decoration:none;
    border-bottom:1px solid var(--line-2);
  }
  .ghost svg{width:14px;height:14px;flex:0 0 auto}
  .ghost:hover,.ghost:focus-visible{color:var(--accent);border-bottom-color:var(--accent)}

  .stats{display:grid;gap:0;align-content:end;max-width:560px}
  @media (min-width:1000px){.stats{max-width:none}}
  .stat{padding:16px 0;border-top:1px solid var(--line)}
  .stat:last-child{border-bottom:1px solid var(--line)}
  .stat b{
    display:block;font-family:var(--display);font-weight:600;
    font-size:clamp(1.45rem,3vw,1.9rem);letter-spacing:-.03em;line-height:1.12;
  }
  .stat--text b{font-size:clamp(1.08rem,2.1vw,1.35rem);letter-spacing:-.015em}
  .stat span{display:block;margin-top:2px;font-size:.82rem;color:var(--mute);letter-spacing:.02em}

  /* ---------- section frame ---------- */
  .sec{padding:clamp(56px,9vw,104px) 0}
  .sec--alt{background:var(--ink-2);border-block:1px solid var(--line)}
  .sec__head{max-width:60ch}
  .sec__head h2{font-size:clamp(1.75rem,4.6vw,2.7rem);margin-top:14px}
  .sec__head p{margin-top:14px;color:var(--mute);max-width:54ch}

  /* ---------- work ---------- */
  .work{display:grid;gap:clamp(52px,8.5vw,104px);margin-top:clamp(40px,7vw,72px)}
  .piece{display:grid;gap:clamp(22px,4vw,52px);align-items:center}
  @media (min-width:920px){
    .piece{grid-template-columns:minmax(0,1.34fr) minmax(0,.66fr)}
    .piece--flip{grid-template-columns:minmax(0,.66fr) minmax(0,1.34fr)}
    .piece--flip .piece__shot{order:2}
    .piece--flip .piece__note{order:1}
  }

  .shot{
    position:relative;display:block;text-decoration:none;
    border-radius:16px;
    background:var(--card-2);
    box-shadow:0 26px 55px -28px rgba(0,0,0,.95),
               0 22px 96px -46px var(--glow,rgba(255,255,255,.3)),
               0 0 0 1px var(--line);
  }
  .shot__bar{
    display:flex;align-items:center;gap:7px;
    padding:0 12px;height:clamp(28px,3.4vw,36px);
    border-radius:16px 16px 0 0;
    background:linear-gradient(180deg,#23232b,#1b1b21);
    border-bottom:1px solid rgba(255,255,255,.06);
  }
  .dots{display:flex;gap:5px;flex:0 0 auto}
