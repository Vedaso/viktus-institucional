---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contato — Grupo Viktus"
  description="Entre em contato com o Grupo Viktus."
>
  <Nav />

  <main class="container">
    <h1>Contato</h1>
    <p class="intro">
      Tem alguma dúvida sobre nossos produtos ou quer saber mais sobre o Grupo Viktus?
      Entre em contato pelos canais abaixo.
    </p>

    <div class="channels">
      <a href="mailto:contato@viktus.com.br" class="channel">
        <span class="icon">✉</span>
        <div>
          <strong>Email</strong>
          <span>contato@viktus.com.br</span>
        </div>
      </a>
    </div>

    <div class="products-links">
      <h2>Suporte dos produtos</h2>
      <p>Para suporte técnico dos produtos, acesse diretamente:</p>
      <ul>
        <li><a href="https://financas.viktus.com.br" target="_blank" rel="noopener">Viktus Finanças →</a></li>
        <li><a href="https://care.viktus.com.br" target="_blank" rel="noopener">Viktus Care →</a></li>
        <li><a href="https://spaces.viktus.com.br" target="_blank" rel="noopener">Viktus Spaces →</a></li>
      </ul>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6);
  }
  h1 { font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: var(--space-6); }
  .intro {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
    max-width: 560px;
  }
  .channels { display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-12); }
  .channel {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background 0.15s;
  }
  .channel:hover { background: var(--color-surface-hover); }
  .icon { font-size: 1.5rem; }
  .channel div { display: flex; flex-direction: column; gap: 2px; }
  .channel strong { color: var(--color-text); font-size: 0.9rem; }
  .channel span { color: var(--color-link); font-size: 0.875rem; }
  h2 { font-size: 1.1rem; font-weight: 700; margin-bottom: var(--space-3); }
  p { font-size: 0.9rem; color: var(--color-text-muted); margin-bottom: var(--space-4); }
  ul { list-style: none; display: flex; flex-direction: column; gap: var(--space-2); }
  li a { font-size: 0.9rem; color: var(--color-link); }
</style>
