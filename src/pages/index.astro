---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ProductCard from '../components/ProductCard.astro';
import Footer from '../components/Footer.astro';
import produtos from '../content/produtos.json';
---

<Layout title="Grupo Viktus — Tecnologia para saúde e gestão">
  <Nav />

  <main>
    <section class="hero">
      <div class="container">
        <img src="/brand/v-mark.png" alt="" class="hero-vmark" aria-hidden="true" />
        <img src="/brand/wordmark-viktus.png" alt="Grupo Viktus" class="hero-wordmark" />
      </div>
    </section>

    <section class="products" id="produtos">
      <div class="container">
        <h2>Nossas soluções</h2>
        <div class="grid">
          {produtos.map((p) => (
            <ProductCard
              name={p.name}
              tagline={p.tagline}
              description={p.description}
              url={p.url}
              status={p.status as 'producao' | 'desenvolvimento' | 'em-breve'}
              ctaLabel={p.ctaLabel}
              accent={p.accent}
              icon={p.icon}
              descriptor={p.descriptor}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="about" id="sobre">
      <div class="container">
        <h2>Sobre o Grupo</h2>
        <p>
          O Grupo Viktus desenvolve software voltado para a realidade das empresas brasileiras.
          Nosso foco está na simplicidade de uso, confiabilidade e integração com os canais que
          seus clientes já utilizam.
        </p>
        <p>
          Cada produto da família Viktus foi construído para resolver um problema real:
          gestão financeira, comunicação com pacientes e controle de espaços — tudo com
          multi-tenancy nativo e infraestrutura moderna.
        </p>
        <a href="/sobre" class="link-sobre">Conheça mais sobre o Grupo →</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hero {
    padding: var(--space-24) var(--space-6) var(--space-16);
    text-align: center;
  }
  .hero-vmark {
    height: clamp(64px, 10vw, 96px);
    width: auto;
    margin: 0 auto var(--space-6);
    display: block;
    opacity: 0.9;
  }
  .hero-wordmark {
    height: clamp(32px, 5vw, 52px);
    width: auto;
    margin: 0 auto var(--space-8);
    display: block;
  }
  .products, .about {
    padding: var(--space-12) var(--space-6);
  }
  .container {
    max-width: var(--max-width-wide);
    margin: 0 auto;
  }
  h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: var(--space-8);
    letter-spacing: -0.02em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .about p {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 640px;
    margin-bottom: var(--space-4);
  }
  .link-sobre {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-link);
  }
</style>
