@font-face{font-family:Bricolage;src:url(/fonts/bricolage-grotesque-ea394f39.woff2) format('woff2');font-weight:200 800;font-display:swap}
@font-face{font-family:Inter;src:url(/fonts/inter-246c9b0d.woff2) format('woff2');font-weight:100 900;font-display:swap}
:root{--escuro:#050714;--cartao:#0D0F17;--papel:#F4F1EB;--lavanda:#C4CCFF;--apoio:#B4B2C2;--tinta:#050714;--tinta2:#3B3A4A;--linha:#232532;--mono:ui-monospace,"SF Mono","Cascadia Mono",Consolas,monospace;
--texto:#ECEBF4;--acento:#C4CCFF;--bolha:#1A1C27}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth}
body{background:var(--escuro);color:#ECEBF4;font:400 17px/1.6 Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
main :is(h1,h2,h3){font-family:Bricolage,Inter,sans-serif;letter-spacing:-.02em;line-height:1.05}
a{color:inherit}
:focus-visible{outline:3px solid var(--lavanda);outline-offset:3px}
.aviso{background:var(--lavanda);color:var(--tinta);font-size:14px;text-align:center;padding:8px 16px}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
main>section{padding:112px 0}
.escuro{background:var(--escuro)}
.papel{background:var(--papel);color:var(--tinta)}
.papel p{color:var(--tinta2)}
/* fine grid behind every section, in both themes (Teak element) */
.escuro,.papel{background-size:48px 48px;background-position:center top}
.escuro{background-image:linear-gradient(rgba(196,204,255,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(196,204,255,.055) 1px,transparent 1px)}
.papel{background-image:linear-gradient(#E6E1D4 1px,transparent 1px),linear-gradient(90deg,#E6E1D4 1px,transparent 1px)}
body>header{position:sticky;top:0;z-index:5;background:rgba(5,7,20,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--linha)}
header .wrap{display:flex;align-items:center;gap:32px;height:68px}
.marca-v{font:700 24px Bricolage,sans-serif;letter-spacing:-.03em;text-decoration:none}
nav{display:flex;align-items:center;gap:28px;margin-left:auto;font:500 13px var(--mono);letter-spacing:.12em;text-transform:uppercase}
nav a{text-decoration:none;color:var(--apoio)}
nav a:hover{color:#fff}
.btn{display:inline-flex;align-items:center;min-height:48px;padding:0 24px;border-radius:0;font:600 14px var(--mono);letter-spacing:.1em;text-transform:uppercase;text-decoration:none;border:0;cursor:pointer}
.btn-1{background:var(--lavanda);color:var(--tinta)}
.btn-1:hover{background:#D6DCFF}
.btn-2{border:1px solid var(--lavanda);color:var(--lavanda);min-height:44px;font-size:13px}
.lnk{color:var(--lavanda);font-weight:500;text-underline-offset:4px;display:inline-flex;align-items:center;min-height:44px}
.marca-v{display:inline-flex;align-items:center;min-height:44px}
footer a{display:inline-flex;align-items:center;min-height:44px}
main :is(h1,h2,h3){text-wrap:balance}
p{text-wrap:pretty}
#hero{padding:120px 0 72px}
#hero h1{font-size:clamp(46px,8.4vw,112px);font-weight:700;max-width:13ch}
#hero p{font-size:clamp(18px,2vw,22px);color:var(--apoio);max-width:46ch;margin:28px 0 36px}
#hero mark{background:linear-gradient(#FFE27A,#FFE27A) 0 0/100% 100% no-repeat;color:#050714;padding:0 .1em;margin-left:-.05em}
nav a:not(.btn)::before{content:"";display:inline-block;width:8px;height:8px;margin-right:8px;background:var(--q)}
nav a:nth-child(1){--q:#A8E6C3}nav a:nth-child(2){--q:#F7B3D6}nav a:nth-child(3){--q:#C4CCFF}
.acoes{display:flex;flex-wrap:wrap;gap:16px 28px;align-items:center}
#de-para{padding:24px 0 120px}
.dp{display:grid;grid-template-columns:1fr auto 1fr;gap:28px;align-items:center}
.seta{font:300 64px Bricolage,sans-serif;color:var(--lavanda)}
.dp-leg{color:var(--apoio);margin-top:28px;font-size:18px;max-width:48ch}
figure{position:relative}
figcaption{font-size:14px;margin-top:14px;color:var(--apoio)}
.papelada{background:#FBFAF5;color:#2A2A35;padding:22px 20px 18px;border-radius:4px;transform:rotate(-1.4deg);box-shadow:0 18px 40px rgba(0,0,0,.45)}
.papelada table{width:100%;border-collapse:collapse;font:400 14px/1.3 'Courier New',monospace}
.papelada th,.papelada td{border:1px solid #C9C6BA;padding:7px 8px;text-align:left}
.papelada th{background:#ECE9DE;font-weight:700}
.papelada .marca{color:#B3261E;font-weight:700}
.papelada figcaption{color:#5B5A66}
.rabisco{position:absolute;font:600 17px/1 Bricolage,sans-serif;color:#B3261E;transform:rotate(-6deg)}
.r1{right:-6px;top:-26px;background:#FFF3B0;color:#7A1F17;padding:8px 12px;box-shadow:0 6px 14px rgba(0,0,0,.35)}
.r2{right:22px;bottom:16px;transform:rotate(-2deg)}
.tela{background:var(--cartao);border:1px solid var(--linha);border-radius:14px;padding:20px}
.tela-topo{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:14px;color:var(--apoio);margin-bottom:12px}
.tela-topo .tot{color:#fff;font-weight:600}
.tela table{width:100%;border-collapse:collapse;font-size:14px}
.tela td{padding:10px 6px;border-top:1px solid var(--linha)}
.tela .num{text-align:right;font-variant-numeric:tabular-nums}
.st{display:inline-block;padding:2px 10px;border-radius:999px;font-size:12px;font-weight:600}
.st-ok{background:#1D3B2E;color:#9BE3BE}
.st-atraso{background:#47201F;color:#FFB4AB}
.st-hoje{background:var(--lavanda);color:var(--tinta)}
.st-futuro{background:#23252F;color:#DDE1FF}
main h2{font-size:clamp(34px,4.6vw,60px);font-weight:700;max-width:18ch;margin-bottom:48px}
.linha{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:40px;align-items:center;padding:36px 0;border-top:1px solid var(--linha)}
.linha:last-child{border-bottom:1px solid var(--linha)}
.linha img{width:100%;height:auto;border-radius:10px;border:1px solid var(--linha);display:block}
.linha h3{font-size:30px;font-weight:600;margin-bottom:10px}
.linha p{color:var(--apoio);max-width:46ch}
.rotulo{font:500 13px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--apoio);padding-bottom:16px;margin-bottom:40px;border-bottom:1px solid var(--linha)}
.papel .rotulo{color:#5A586A;border-color:#D9D4C8}
.amb{display:grid;grid-template-columns:1fr 1fr;gap:28px 64px;align-items:end;margin-bottom:40px}
.amb h2{margin-bottom:0;font-size:clamp(34px,4.2vw,54px);max-width:none}
.amb h2 em{font-style:normal;color:var(--acento)}
.amb-txt>p{color:var(--apoio);font-size:18px;max-width:46ch}
.pecas{margin-top:24px;display:flex;flex-wrap:wrap;gap:8px;font-size:14px;color:var(--texto)}
.pecas span{width:100%;font-size:13px;color:var(--apoio);margin-bottom:2px}
.pecas b{font-weight:500;display:inline-flex;align-items:center;gap:7px;padding:5px 11px;border:1px solid var(--linha);background:var(--cartao);border-radius:999px}
.pecas b::before{content:"";width:7px;height:7px;background:var(--q)}
.pecas b:nth-of-type(3n+1){--q:#A8E6C3}.pecas b:nth-of-type(3n+2){--q:#F7B3D6}.pecas b:nth-of-type(3n){--q:#C4CCFF}
#produtos{min-height:100svh;display:flex;align-items:center;padding:72px 0}
#produtos>.wrap{width:100%}
/* bento of living screens */
/* hairlines drawn by each card's right/bottom shadow; the frame clips the outer edges, so any count works */
.bento{list-style:none;padding:0;display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--linha);background:var(--cartao);overflow:hidden}
.card{padding:18px;min-width:0;box-shadow:1px 1px 0 var(--linha)}
.barras{display:flex;align-items:flex-end;gap:6px;height:96px;margin-bottom:12px;border-bottom:1px solid var(--linha)}
.barras span{flex:1;height:var(--h);background:var(--bolha);border-radius:3px 3px 0 0}
.barras .ult{background:var(--lavanda);transform-origin:bottom;animation:cresce 7s var(--ease-out) infinite}
.v-tra .ck{animation:pinga2 7s var(--ease-out) infinite}
@keyframes cresce{0%,25%{scale:1 .2}40%,92%{scale:1 1}100%{scale:1 .2}}
.card-topo{display:flex;align-items:center;gap:10px;font:600 15px Inter,sans-serif;color:var(--texto);margin-bottom:16px}
.ico{width:40px;height:40px;border-radius:24%;display:block;box-shadow:0 0 0 1px rgba(127,127,160,.25)}
.viva{position:relative;height:150px;font-size:12px;color:var(--texto)}
.ck{display:inline-block;font-style:normal;font-weight:600;font-size:11px;padding:2px 9px;border-radius:999px;white-space:nowrap}
.ck.ok{background:#1D3B2E;color:#9BE3BE}
.ck.fut{background:#23252F;color:#DDE1FF}
.vl{display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:center;padding:9px 0;border-top:1px solid var(--linha)}
.vl b{font-weight:500;font-variant-numeric:tabular-nums}
.troca{height:19px;overflow:hidden;padding:0;background:var(--lavanda);color:#050714;animation:fundo 6s infinite}
.troca em{display:block;font-style:normal;line-height:19px;padding:0 9px;animation:rola 6s var(--ease-out) infinite}
@keyframes rola{0%,40%{translate:0 0}50%,92%{translate:0 -19px}100%{translate:0 0}}
@keyframes fundo{0%,42%{background:var(--lavanda);color:#050714}50%,92%{background:#1D3B2E;color:#9BE3BE}100%{background:var(--lavanda);color:#050714}}
.bol{max-width:88%;padding:7px 10px;border-radius:10px;line-height:1.35;margin-bottom:8px}
.bol.in{background:var(--bolha);border-top-left-radius:2px}
.bol.out{background:#1F5C45;color:#E8FFF4;margin-left:auto;border-top-right-radius:2px;animation:pinga 7s var(--ease-out) infinite}
.v-care .ck{animation:pinga2 7s var(--ease-out) infinite}
@keyframes pinga{0%,30%{opacity:0;translate:0 8px;scale:.9}38%,92%{opacity:1;translate:0 0;scale:1}100%{opacity:0}}
@keyframes pinga2{0%,48%{opacity:0;translate:0 6px}56%,92%{opacity:1;translate:0 0}100%{opacity:0}}
.grade{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;margin-bottom:12px}
.grade span{height:26px;border-radius:4px;background:var(--bolha)}
.grade .oc{background:#3A3E57}
.grade .nova{background:var(--lavanda);animation:reserva 6.5s var(--ease-out) infinite}
.v-spa .ck{animation:pinga2 6.5s var(--ease-out) infinite}
@keyframes reserva{0%,25%{scale:.2;opacity:0}36%,92%{scale:1;opacity:1}100%{scale:.2;opacity:0}}
.tv{position:relative;aspect-ratio:16/9;border:5px solid #1A1A22;border-radius:6px;overflow:hidden;margin-bottom:12px;background:#000}
.arte{position:absolute;inset:0;display:grid;place-items:center;font:700 15px Bricolage,sans-serif;color:#fff}
.a1{background:linear-gradient(135deg,#E8590C,#B3261E)}
.a2{background:linear-gradient(135deg,#2B8A3E,#0B7285);animation:tela 8s infinite}
.v-tel .ck{animation:pinga2 8s var(--ease-out) infinite}
@keyframes tela{0%,45%{clip-path:inset(0 100% 0 0)}55%,92%{clip-path:inset(0 0 0 0)}100%{clip-path:inset(0 0 0 100%)}}
.sob{display:flex;align-items:center;gap:10px;margin:32px 0 14px;font:500 13px var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--texto)}
.mais{width:28px;height:28px;display:grid;place-items:center;background:var(--papel);color:var(--tinta);border-radius:8px;font:600 20px/1 Inter,sans-serif;letter-spacing:0}
.galeria{list-style:none;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.obra{display:flex;flex-direction:column;gap:8px;font-size:14px;color:var(--apoio)}
.obra img{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;object-position:top;border-radius:8px;border:1px solid var(--linha);display:block}
.mais-texto{margin-top:24px;max-width:56ch}
.mais-texto summary{cursor:pointer;display:inline-flex;align-items:center;gap:8px;min-height:44px;font:600 14px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--tinta);list-style:none}
.mais-texto summary::-webkit-details-marker{display:none}
.mais-texto summary::after{content:"+";font:600 20px/1 Inter,sans-serif}
.mais-texto[open] summary::after{content:"−"}
.mais-texto p{font-size:18px;margin-top:12px}
.passos{list-style:none;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:32px;border-top:2px solid var(--tinta);padding-top:28px}
.carimbo{display:flex;align-items:stretch;margin-bottom:14px;font-size:30px;color:var(--tinta)}
.carimbo .n{display:grid;place-items:center;min-width:44px;background:var(--tinta);color:var(--papel);font:700 16px var(--mono)}
.carimbo .pal{padding:2px 12px 4px;background:linear-gradient(var(--cor),var(--cor)) 0 0/100% 100% no-repeat;text-transform:lowercase}
:is(.passos,.entregas) li:nth-child(1){--cor:#C4CCFF}
:is(.passos,.entregas) li:nth-child(2){--cor:#F7B3D6}
:is(.passos,.entregas) li:nth-child(3){--cor:#A8E6C3}
:is(.passos,.entregas) li:nth-child(4){--cor:#FFE27A}
/* deliverables reuse the method stamps */
.entregas{list-style:none;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:32px;border-top:2px solid var(--texto);padding-top:28px}
.entregas .carimbo{font-size:22px;line-height:1.15;min-height:2.9em}
.entregas .pal{flex:1;display:flex;align-items:center}
.entregas .carimbo .n{background:var(--texto);color:var(--escuro)}
.entregas .pal{color:#050714;text-transform:none;padding:4px 10px 5px}
.entregas p{color:var(--apoio)}
#origem p:not(.rotulo){color:var(--apoio);font-size:20px;max-width:52ch;margin-bottom:24px}
#origem h2,#entregas h2{max-width:22ch}
#como h2{max-width:none}
#entregas h2{margin-bottom:16px}
.sub{color:var(--apoio);font-size:19px;max-width:52ch;margin-bottom:40px}
.numeros{list-style:none;padding:0;display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--linha);background:var(--cartao);margin:8px 0 32px}
.numeros li{padding:22px 24px;border-right:1px solid var(--linha);display:flex;flex-direction:column;gap:4px}
.numeros li:last-child{border-right:0}
.numeros b{font:700 clamp(30px,3.4vw,44px)/1 Bricolage,sans-serif;letter-spacing:-.02em;color:var(--texto)}
.numeros span{font-size:15px;color:var(--apoio)}
@media (max-width:520px){.numeros{grid-template-columns:1fr}.numeros li{border-right:0;border-bottom:1px solid var(--linha)}.numeros li:last-child{border-bottom:0}}
#conversa h2{margin-bottom:20px}
#conversa p{font-size:20px;margin-bottom:36px}
#conversa .btn-1{background:var(--tinta);color:var(--papel)}
#conversa .btn-1:hover{background:#1B2147}
footer{padding:40px 0;color:var(--apoio);font-size:14px;border-top:1px solid var(--linha)}
@media (max-width:860px){
 nav a:not(.btn){display:none}
 section{padding:80px 0}
 #hero{padding:72px 0 48px}
 .dp{grid-template-columns:1fr}
 .seta{transform:rotate(90deg);justify-self:center;line-height:.6}
 .linha,.entregas li{grid-template-columns:1fr;gap:18px}
 .amb{grid-template-columns:1fr;gap:20px}
 .bento{grid-template-columns:1fr 1fr}
 .passos,.entregas{grid-template-columns:1fr 1fr}
}
@media (max-width:520px){
 .wrap{padding:0 16px}
 .passos,.entregas{grid-template-columns:1fr}
 .bento{grid-template-columns:1fr}
 .viva{height:auto;min-height:120px}
 .galeria{grid-template-columns:1fr 1fr;gap:10px}
 #produtos{min-height:0}
 .papelada table{font-size:12px}
 .papelada th,.papelada td{padding:6px 5px}
 .r1{right:4px;top:-22px;font-size:15px}
 .r2{display:none}
}
/* motion: transform-only so content is never hidden; scroll-driven where supported */
main>section{overflow-x:clip}
:root{--ease-out:cubic-bezier(0.23,1,0.32,1)}
#hero h1 .ln{display:inline-block;animation:sobe 900ms var(--ease-out) both}
#hero h1 .ln:nth-child(2){animation-delay:90ms}
#hero h1 .ln:nth-child(3){animation-delay:180ms}
#hero h1~*{animation:sobe 900ms var(--ease-out) 300ms both}
@keyframes sobe{from{translate:0 0.45em;opacity:0}to{translate:0 0;opacity:1}}
@supports (animation-timeline:view()){
 .seta{animation:seta linear both;animation-timeline:view();animation-range:entry 20% cover 45%}
 @keyframes seta{from{translate:-40px 0}to{translate:0 0}}
 section h2{transform-origin:50% 100%;animation:inclina linear both;animation-timeline:view();animation-range:entry 0% entry 100%}
 @keyframes inclina{from{transform:perspective(700px) rotateX(38deg) translateY(24px)}to{transform:none}}
 .rotulo{background:linear-gradient(var(--lavanda),var(--lavanda)) 0 100%/0 1px no-repeat;animation:risca linear both;animation-timeline:view();animation-range:entry 0% entry 100%}
 @keyframes risca{to{background-size:100% 1px}}
 .card{animation:surge linear both;animation-timeline:view();animation-range:entry 0% entry 100%}
 .card:nth-child(2){animation-range:entry 10% entry 100%}
 .card:nth-child(3){animation-range:entry 20% entry 100%}
 .card:nth-child(4){animation-range:entry 30% entry 100%}
 @keyframes surge{from{translate:0 40px}to{translate:0 0}}
 .carimbo .pal{animation:grifa linear both;animation-timeline:view();animation-range:entry 20% entry 100%}
 @keyframes grifa{from{background-size:0 100%}to{background-size:100% 100%}}
 #hero mark{animation:grifa 900ms var(--ease-out) 500ms both}
 .obra img{animation:revela linear both;animation-timeline:view();animation-range:entry 0% entry 100%}
 @keyframes revela{from{clip-path:inset(0 0 60% 0 round 8px);scale:1.06}to{clip-path:inset(0 0 0 0 round 8px);scale:1}}
}
@media not all and (prefers-color-scheme:light){
.papel{--papel:#050714;--tinta:#ECEBF4;--tinta2:#B4B2C2;background-color:#050714;background-image:linear-gradient(rgba(196,204,255,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(196,204,255,.055) 1px,transparent 1px);border-top:1px solid var(--linha)}
.papel .rotulo{color:var(--apoio);border-color:var(--linha)}
.papel .carimbo .pal{color:#050714}
.papel .mais{background:var(--cartao);border:1px solid var(--linha)}
#conversa .btn-1:hover{background:#D6D9F5}
}
@media (prefers-color-scheme:light){
:root{--escuro:#F6F5F0;--cartao:#FFFFFF;--linha:#E0DED5;--apoio:#55546A;--texto:#14162B;--acento:#3341C4;--bolha:#ECEEF8}
body{color:var(--texto)}
.escuro{background-color:#F6F5F0;background-image:linear-gradient(#ECEAE2 1px,transparent 1px),linear-gradient(90deg,#ECEAE2 1px,transparent 1px)}
body>header{background:rgba(246,245,240,.92)}
nav a:hover{color:var(--texto)}
.btn-1{background:#14162B;color:#F6F5F0}.btn-1:hover{background:#2A2E55}
.btn-2{border-color:#14162B;color:#14162B}
.lnk{color:var(--acento)}
