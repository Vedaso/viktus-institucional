---
// Gerado a partir de v2.html, a versão que o Victor aprovou em 04/09/2026.
// A meta build-commit é o que o smoke do deploy procura: sem ela o gate reprova.
const buildCommit = import.meta.env.GIT_COMMIT ?? process.env.GIT_COMMIT ?? 'dev';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Viktus — Primeiro o processo, depois a ferramenta</title>
    <meta name="description" content="Produtos e sistemas em produção com clientes reais: SaaS financeiro, automação de atendimento clínica-paciente, BI e plataformas de reserva de espaços." />
    <meta name="build-commit" content={buildCommit} />
    <link rel="canonical" href="https://viktus.com.br/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Viktus — Primeiro o processo, depois a ferramenta" />
    <meta property="og:description" content="Produtos e sistemas em produção com clientes reais: SaaS financeiro, automação de atendimento clínica-paciente, BI e plataformas de reserva de espaços." />
    <meta property="og:url" content="https://viktus.com.br/" />
    <meta property="og:image" content="https://viktus.com.br/og-image.png" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
<style is:global is:global>
  /* Tipografia embutida: a pagina nao depende de rede nem do Google. */
  @font-face{font-family:"Bricolage Grotesque";font-style:normal;font-weight:200 800;font-display:swap;src:url(/fonts/bricolage-grotesque-ea394f39.woff2) format("woff2")}
  @font-face{font-family:"Inter";font-style:normal;font-weight:100 900;font-display:swap;src:url(/fonts/inter-246c9b0d.woff2) format("woff2")}
  :root{
    --ink:#050714;
    --ink-2:#090c1c;
    --card:#0E1330;
    --card-2:#151b3d;
    --line:rgba(255,255,255,.09);
    --line-2:rgba(255,255,255,.17);
    --bone:#f4f1eb;
    --mute:#adaaa3;
    --mute-2:#96938c;
    --accent:#F2EEE3;
    --shell:min(1240px,100%);
    --pad:clamp(18px,5vw,44px);
    --display:"Bricolage Grotesque","Segoe UI Variable Display","Segoe UI",system-ui,sans-serif;
    --text:"Inter","Segoe UI",system-ui,sans-serif;
    --wm:url("/wordmark-viktus.png");
  }
  *,*::before,*::after{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  body{
    margin:0;
    background:var(--ink);
    color:var(--bone);
    font-family:var(--text);
    font-size:16px;
    line-height:1.6;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;display:block}
  a{color:inherit}
  h1,h2,h3{font-family:var(--display);font-weight:600;letter-spacing:-.028em;line-height:1.03;margin:0}
  p{margin:0}

  .shell{width:var(--shell);margin-inline:auto;padding-inline:var(--pad)}
  .eyebrow{
    font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;
    color:var(--accent);font-weight:600;font-family:var(--text);
  }
  .skip{
    position:absolute;left:-9999px;top:0;background:var(--bone);color:var(--ink);
    padding:14px 18px;border-radius:0 0 10px 0;z-index:99;font-weight:600;
  }
  .skip:focus{left:0}
  :focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:6px}

  .wordmark{
    display:block;background:var(--wm) left center/contain no-repeat;
    width:73px;height:22px;
  }

  /* ---------- header ---------- */
  .top{
    position:sticky;top:0;z-index:40;
    background:rgba(5,7,20,.82);
    backdrop-filter:blur(14px);
    border-bottom:1px solid var(--line);
  }
  .top__in{
    display:flex;align-items:center;justify-content:space-between;gap:10px;
    min-height:64px;
  }
  .top__mark{display:inline-flex;align-items:center;min-height:44px;padding-right:6px}
  .nav{display:flex;align-items:center;gap:2px}
  .nav a{
    display:inline-flex;align-items:center;justify-content:center;
    min-height:44px;min-width:44px;padding:10px 12px;border-radius:10px;
    font-size:.85rem;font-weight:500;color:var(--mute);text-decoration:none;
  }
  .nav a:hover,.nav a:focus-visible{color:var(--bone);background:rgba(255,255,255,.07)}
  /* telas muito estreitas (320px, ou 390px com zoom de texto): o header precisa caber */
  @media (max-width:400px){
    .top__in{gap:4px}
    .wordmark{width:60px;height:18px}
    .nav{
      gap:0;
      overflow-x:auto;overflow-y:hidden;
      scrollbar-width:none;-ms-overflow-style:none;
      padding-block:4px;margin-block:-4px;
    }
    .nav::-webkit-scrollbar{display:none}
    .nav a{padding:10px 8px;font-size:.8rem}
  }

  /* ---------- hero ---------- */
  .hero{padding:clamp(52px,9.5vw,104px) 0 clamp(44px,7vw,80px);position:relative;overflow:hidden}
  .hero::before{
    content:"";position:absolute;inset:-40% -10% auto -20%;height:130%;
    background:radial-gradient(46% 44% at 26% 30%,rgba(46,60,140,.20),transparent 68%),
               radial-gradient(42% 40% at 82% 18%,rgba(96,120,190,.15),transparent 70%);
    pointer-events:none;
  }
  .hero__in{position:relative;display:grid;gap:clamp(38px,5vw,64px)}
  @media (min-width:1000px){
    .hero__in{grid-template-columns:minmax(0,1.42fr) minmax(0,.58fr);align-items:end;gap:clamp(40px,5vw,72px)}
  }
  .hero h1{
    font-size:clamp(2.15rem,5.6vw,3.9rem);
    font-weight:700;
    max-width:20ch;
    margin:18px 0 0;
    text-wrap:balance;
  }
  h1 em{font-style:normal;color:rgba(242,238,227,.55)}
  .lede{
    margin-top:22px;max-width:50ch;
    font-size:clamp(1.02rem,2.1vw,1.24rem);
    color:var(--mute);
  }
  .hero__acts{
    display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;margin-top:30px;
  }
  .ghost{
    display:inline-flex;align-items:center;gap:9px;
    min-height:44px;padding:0 2px;
    font-size:.95rem;font-weight:600;color:var(--bone);text-decoration:none;
    border-bottom:1px solid var(--line-2);
  }
  .ghost svg{width:14px;height:14px;flex:0 0 auto}
  .ghost:hover,.ghost:focus-visible{color:var(--accent);border-bottom-color:var(--accent)}

  .stats{display:grid;gap:0;align-content:end;max-width:560px}
  @media (min-width:1000px){.stats{max-width:none}}
  .stat{padding:16px 0;border-top:1px solid var(--line)}
  .stat:last-child{border-bottom:1px solid var(--line)}
  .stat b{
    display:block;font-family:var(--display);font-weight:600;
    font-size:clamp(1.45rem,3vw,1.9rem);letter-spacing:-.03em;line-height:1.12;
  }
  .stat--text b{font-size:clamp(1.08rem,2.1vw,1.35rem);letter-spacing:-.015em}
  .stat span{display:block;margin-top:2px;font-size:.82rem;color:var(--mute);letter-spacing:.02em}

  /* ---------- section frame ---------- */
  .sec{padding:clamp(56px,9vw,104px) 0}
  .sec--alt{background:var(--ink-2);border-block:1px solid var(--line)}
  .sec__head{max-width:60ch}
  .sec__head h2{font-size:clamp(1.75rem,4.6vw,2.7rem);margin-top:14px}
  .sec__head p{margin-top:14px;color:var(--mute);max-width:54ch}

  /* ---------- work ---------- */
  .work{display:grid;gap:clamp(52px,8.5vw,104px);margin-top:clamp(40px,7vw,72px)}
  .piece{display:grid;gap:clamp(22px,4vw,52px);align-items:center}
  @media (min-width:920px){
    .piece{grid-template-columns:minmax(0,1.34fr) minmax(0,.66fr)}
    .piece--flip{grid-template-columns:minmax(0,.66fr) minmax(0,1.34fr)}
    .piece--flip .piece__shot{order:2}
    .piece--flip .piece__note{order:1}
  }

  .shot{
    position:relative;display:block;text-decoration:none;
    border-radius:16px;
    background:var(--card-2);
    box-shadow:0 26px 55px -28px rgba(0,0,0,.95),
               0 22px 96px -46px var(--glow,rgba(255,255,255,.3)),
               0 0 0 1px var(--line);
  }
  .shot__bar{
    display:flex;align-items:center;gap:7px;
    padding:0 12px;height:clamp(28px,3.4vw,36px);
    border-radius:16px 16px 0 0;
    background:linear-gradient(180deg,#23232b,#1b1b21);
    border-bottom:1px solid rgba(255,255,255,.06);
  }
  .dots{display:flex;gap:5px;flex:0 0 auto}
  .dots i{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.24);display:block}
  .url{
    flex:1 1 auto;min-width:0;text-align:center;
    font-size:clamp(.62rem,1.5vw,.72rem);letter-spacing:.04em;
    color:#cfccc6;
    background:rgba(255,255,255,.07);
    border-radius:99px;padding:2px 10px;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  }
  .shot__img{
    position:relative;display:block;
    aspect-ratio:16/10;width:100%;overflow:hidden;
    border-radius:0 0 16px 16px;background:#0f0f13;
  }
  .shot__img img{width:100%;height:100%;object-fit:cover;object-position:top center}
  /* scrim: dá superfície ao botão em vez de deixá-lo colidir com a UI do site */
  .shot__img::after{
    content:"";position:absolute;left:0;right:0;bottom:0;height:34%;
    background:linear-gradient(to top,rgba(7,7,9,.86),rgba(7,7,9,.5) 42%,transparent);
    pointer-events:none;
  }
  .shot__go{
    position:absolute;left:14px;bottom:14px;
    display:inline-flex;align-items:center;gap:8px;
    min-height:44px;padding:0 18px;border-radius:99px;
    background:rgba(12,12,15,.86);
    backdrop-filter:blur(6px);
    border:1px solid var(--line-2);
    font-size:.8rem;font-weight:600;color:var(--bone);
  }
  @media (max-width:620px){
    /* encolhe a caixa, nunca a altura: 44px é o piso de alvo de toque */
    .shot__go{min-height:44px;padding:0 14px;font-size:.74rem;left:10px;bottom:10px}
  }
  .shot__go svg{width:13px;height:13px;flex:0 0 auto}
  @media (prefers-reduced-motion:no-preference){
    .shot,.shot__go{transition:transform .45s cubic-bezier(.2,.7,.3,1),box-shadow .45s ease,background .25s ease,color .25s ease}
    .shot:hover,.shot:focus-visible{transform:translateY(-6px)}
    .shot:hover{box-shadow:0 40px 70px -30px rgba(0,0,0,.95),
                           0 26px 110px -40px var(--glow,rgba(255,255,255,.3)),
                           0 0 0 1px var(--line-2)}
    .shot:hover .shot__go,.shot:focus-visible .shot__go{background:var(--bone);color:var(--ink);border-color:var(--bone)}
  }

  /* archive piece (no screenshot) */
  .shot--archive{--x:0;display:grid;place-items:center;aspect-ratio:16/10;border-radius:0 0 16px 16px;overflow:hidden;text-align:center;padding:24px;background:radial-gradient(76% 120% at 50% 118%,rgba(46,60,140,.20),transparent 66%),linear-gradient(160deg,#151b3d,#0b0e20)}
  .shot--archive .word{
    font-family:var(--display);font-weight:600;
    font-size:clamp(1.6rem,5.6vw,3rem);letter-spacing:.06em;
    line-height:1;
  }
  .shot--archive .sub{
    margin-top:10px;font-size:.74rem;letter-spacing:.2em;text-transform:uppercase;color:var(--mute);
  }

  .piece__logo{height:var(--logo-h,30px);width:auto;max-width:190px;object-fit:contain;object-position:left center}
  .piece__title{
    font-family:var(--display);font-weight:600;letter-spacing:-.025em;
    font-size:clamp(1.35rem,3.2vw,1.85rem);line-height:1.14;margin:10px 0 0;
  }
  .piece__desc{margin-top:14px;color:var(--mute);font-size:.97rem}

  /* ---------- products ---------- */
  .prods{display:grid;gap:16px;margin-top:clamp(34px,5vw,54px)}
  @media (min-width:600px){.prods{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}}
  @media (min-width:1040px){.prods{grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}}
  .prod{
    display:flex;flex-direction:column;gap:10px;text-decoration:none;
    min-height:44px;padding:22px 22px 20px;
    border-radius:14px;background:var(--card);
    box-shadow:0 0 0 1px var(--line);
  }
  .ico{
    width:40px;height:40px;border-radius:11px;flex:0 0 auto;
    display:grid;place-items:center;
    background:rgba(255,255,255,.055);
    box-shadow:inset 0 0 0 1px var(--line);
  }
  .ico svg{width:24px;height:24px;display:block}
  .prod h3{font-size:1.04rem;font-weight:600;margin-top:6px}
  .prod p{color:var(--mute);font-size:.9rem;flex:1}
  .prod__link{
    display:inline-flex;align-items:center;gap:7px;margin-top:4px;
    font-size:.79rem;font-weight:600;color:var(--accent);
    letter-spacing:.01em;
  }
  .prod__link svg{width:12px;height:12px;flex:0 0 auto}
  @media (prefers-reduced-motion:no-preference){
    .prod{transition:transform .3s ease,box-shadow .3s ease,background .3s ease}
    .prod:hover,.prod:focus-visible{transform:translateY(-4px);background:var(--card-2);box-shadow:0 0 0 1px var(--line-2),0 26px 50px -30px rgba(0,0,0,.95)}
  }

  /* internal tool band */
  .band{
    display:flex;flex-wrap:wrap;align-items:flex-start;gap:16px 22px;
    margin-top:20px;padding:20px 22px;border-radius:14px;
    background:var(--card);box-shadow:0 0 0 1px var(--line);
  }
  .band .flag{align-self:center}
  .band__txt{min-width:min(100%,230px);flex:1 1 320px}
  .band h3{font-size:1.02rem;font-weight:600}
  .band p{margin-top:6px;color:var(--mute);font-size:.9rem;max-width:62ch}
  .flag{
    display:inline-flex;align-items:center;gap:8px;flex:0 0 auto;
    padding:8px 14px;border-radius:99px;
    font-size:.72rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
    color:var(--mute);background:rgba(255,255,255,.05);
    box-shadow:inset 0 0 0 1px var(--line);
  }
  .flag i{width:6px;height:6px;border-radius:50%;background:var(--mute-2);display:block}

  /* ---------- about / contact ---------- */
  .about{display:grid;gap:clamp(32px,5vw,56px);align-items:start}
  /* Duas colunas ja a partir de 760px: acima disso empilhar deixava meia tela vazia. */
  @media (min-width:760px){
    .about{grid-template-columns:minmax(0,1fr) minmax(0,clamp(240px,26vw,320px));
           gap:clamp(34px,5vw,72px);align-items:center}
  }
  .about__col h2{font-size:clamp(1.55rem,3.8vw,2.3rem);margin-top:14px}
  .about__col p:not(.eyebrow){color:var(--mute);margin-top:16px;font-size:1.02rem;max-width:56ch}
  /* trilhos do Sobre: mesmo desenho dos stats do hero, para dar corpo a coluna */
  .facts{list-style:none;margin:26px 0 0;padding:0;display:grid}
  .facts li{padding:13px 0;border-top:1px solid var(--line)}
  .facts li:last-child{border-bottom:1px solid var(--line)}
  .facts b{display:block;font-family:var(--display);font-weight:600;
           font-size:clamp(1rem,1.9vw,1.12rem);letter-spacing:-.018em;line-height:1.2}
  .facts span{display:block;margin-top:3px;font-size:.82rem;color:var(--mute);letter-spacing:.02em}
  .cta{
    display:inline-flex;align-items:center;gap:10px;margin-top:28px;
    min-height:52px;padding:0 24px;border-radius:99px;
    background:var(--bone);color:var(--ink);
    font-weight:600;text-decoration:none;font-size:.95rem;
  }
  .cta svg{width:14px;height:14px;flex:0 0 auto}
  .cta--line{
    background:transparent;color:var(--bone);
    box-shadow:inset 0 0 0 1px var(--line-2);
    min-height:48px;margin-top:0;
  }
  @media (prefers-reduced-motion:no-preference){
    .cta{transition:background .25s ease,color .25s ease,transform .25s ease,box-shadow .25s ease}
    .cta:hover,.cta:focus-visible{transform:translateY(-2px)}
  }
  .cta:hover,.cta:focus-visible{background:var(--accent);color:var(--ink)}
  .cta--line:hover,.cta--line:focus-visible{background:var(--bone);color:var(--ink);box-shadow:inset 0 0 0 1px var(--bone)}

  .face{max-width:320px}
  /* faixa em que o Sobre ainda empilha: retrato e legenda lado a lado, sem vao morto */
  @media (min-width:560px) and (max-width:759.98px){
    .face{max-width:none;display:grid;align-items:center;
          grid-template-columns:minmax(0,clamp(250px,36vw,320px)) minmax(0,1fr);
          gap:clamp(22px,4vw,36px)}
    .face__id{align-self:center}
    .face b{margin-top:0;font-size:1.24rem}
  }
  .face img{
    /* height:auto é obrigatório: sem ele o atributo height="659" vence o aspect-ratio
       e o retrato renderiza 320x659 (uma lasca), inflando o bloco inteiro. */
    width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;object-position:50% 18%;
    border-radius:16px;box-shadow:0 0 0 1px var(--line-2),0 30px 60px -34px rgba(0,0,0,.95);
  }
  .face b{display:block;margin-top:16px;font-family:var(--display);font-size:1.08rem;font-weight:600;letter-spacing:-.01em}
  .face span{display:block;margin-top:4px;font-size:.88rem;color:var(--mute);max-width:34ch}
  .face .loc{margin-top:8px;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--mute-2)}

  /* ---------- footer ---------- */
  .foot{border-top:1px solid var(--line);padding:34px 0 46px;background:var(--ink)}
  .foot__in{display:flex;flex-wrap:wrap;gap:16px 28px;align-items:center;justify-content:space-between}
  .foot .wordmark{width:60px;height:18px;opacity:.9}
  .foot p{font-size:.79rem;color:var(--mute);max-width:46ch}

  
  /* ---------------- movimento ----------------
     Padrão à prova de falha: o conteúdo é VISÍVEL por padrão. A animação só acontece
     quando o JS marca <html class="js">, e o JS só marca se ele mesmo rodar. Sem JS,
     sem suporte, ou com prefers-reduced-motion, a página aparece inteira e parada.
     Tentei primeiro com animation-timeline: view() e sem JS — e a página inteira abaixo
     do hero ficou em opacity:0 na captura de página inteira. Depois, com opacity na
     transição, o axe leu os elementos ainda não revelados como contraste 1.01:1 e
     reprovou 24 vezes. Por isso a revelação é SÓ de deslocamento: o texto está sempre
     opaco, o instrumento mede o que o leitor vê, e o movimento continua existindo. */
  @media (prefers-reduced-motion: no-preference) {
    .js .rv { transform:translateY(24px);
              transition:transform .62s cubic-bezier(.22,.61,.36,1) }
    .js .rv.in { transform:none }
    .js .rv:nth-child(2){ transition-delay:.06s }
    .js .rv:nth-child(3){ transition-delay:.12s }
    .js .rv:nth-child(4){ transition-delay:.18s }

    /* o hero está na tela quando a página abre: entra sozinho, sem esperar scroll */
    .js .hero h1, .js .hero .lede, .js .hero__acts, .js .hero .stats {
      animation:surge .72s cubic-bezier(.22,.61,.36,1) both }
    .js .hero .lede { animation-delay:.07s }
    .js .hero__acts { animation-delay:.14s }
    .js .hero .stats{ animation-delay:.21s }
    @keyframes surge { from{transform:translateY(18px)} to{transform:none} }

    /* a imagem respira ao entrar: dá profundidade sem parallax e sem custo de layout */
    .js .piece__shot { transition:transform .9s cubic-bezier(.22,.61,.36,1) }
    .js .rv:not(.in) .piece__shot { transform:scale(.972) }
  }
  .hero h1 + .slogan{margin-top:24px;font-size:clamp(1.02rem,1.9vw,1.2rem);color:rgba(242,238,227,.72)}
  .slogan{margin-top:14px;font-family:var(--display);font-size:clamp(.98rem,1.5vw,1.12rem);color:rgba(242,238,227,.62);letter-spacing:-.01em;max-width:44ch}
</style>
      <style is:global>
    </style>
      <style is:global>
      /* O tile da Crossmetic não tem barra de navegador (não há site para mostrar), então
         para a altura bater com os cards vizinhos ele soma a altura da barra ao próprio corpo. */
      
      
    </style>
      <style is:global>
      /* o tile arquivado não é link: herda a casca só para a geometria bater com os vizinhos */
      .shot--arch-wrap{cursor:default;display:block}
      .shot--arch-wrap:hover{transform:none}
    </style>
      <style is:global>
      .piece__kicker{font-family:var(--text);font-size:.72rem;font-weight:600;
        letter-spacing:.18em;text-transform:uppercase;color:var(--mute-2);margin-bottom:12px}
    </style>
      <style is:global>
      /* Fecha a seção de produtos levando para a outra frente. Sem isso, a página termina
         nos produtos e o portfólio de clientes só existe pela nav. */
      .passagem{display:flex;align-items:center;justify-content:space-between;gap:24px;
        margin-top:clamp(20px,2.6vw,30px);padding:clamp(22px,2.6vw,30px) clamp(24px,3vw,34px);
