        font-weight:600;letter-spacing:-.02em;color:var(--bone)}
      .passagem__go{flex:0 0 auto;font-size:1.3rem;color:var(--mute);transition:transform .3s var(--ease)}
      .passagem:hover .passagem__go{transform:translateX(5px);color:var(--bone)}
      @media (prefers-reduced-motion:reduce){.passagem,.passagem__go{transition:none}
        .passagem:hover{transform:none}.passagem:hover .passagem__go{transform:none}}
    </style>
  </head>
