---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ProductCell from '../components/ProductCell.astro';
import Footer from '../components/Footer.astro';
import produtos from '../content/produtos.json';
import cases from '../content/cases.json';

const sistemasNoAr = produtos.filter((p) => p.status !== 'em-breve').length + cases.length - 1;
// Crossmetic está encerrado, não conta como sistema no ar.

const ferramentas = [
  {
    name: 'Argus',
    description: 'Orquestrador de agentes que roda o parque de infraestrutura, publica o painel de roadmap e executa os crons dos servidores.',
  },
  {
    name: 'Viktus Estudos',
    description: 'Biblioteca pessoal de estudo, com companions de leitura e workbooks de idioma gerados por IA.',
  },
];
---

<Layout
  title="Victor Omena — Sistemas que resolvem, não protótipos"
  description="Construo produtos e sistemas que rodam negócios de verdade: SaaS financeiro, automação de atendimento, BI e plataformas de reserva."
>
  <Nav />

  <main>
    <section class="hero">
      <div class="container">
        <div class="byline reveal">
          <img src="/profile/victor-omena.jpg" alt="Victor Omena" width="56" height="56" class="avatar" />
          <span>Victor Omena · Maceió, AL</span>
        </div>
        <h1 class="display reveal">Sistemas que resolvem, <em>não protótipos.</em></h1>
        <p class="lede reveal">
          De SaaS financeiro a automação de atendimento: o que já está no ar, com clientes reais.
        </p>
        <dl class="facts reveal">
          <div>
            <dt>Sistemas no ar</dt>
            <dd>{sistemasNoAr}</dd>
          </div>
          <div>
            <dt>Setores</dt>
            <dd>Saúde · RH · Hospitalidade</dd>
          </div>
          <div>
            <dt>Sede</dt>
            <dd>Maceió, AL</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="products" id="produtos">
      <div class="container">
        <h2 class="label reveal">Produtos Viktus</h2>
        <div class="grid grid--flat reveal">
          {produtos.map((p) => (
            <ProductCell
              name={p.name}
              tagline={p.tagline}
              description={p.description}
              url={p.url}
              status={p.status as 'producao' | 'ativo' | 'piloto' | 'desenvolvimento' | 'em-breve'}
              ctaLabel={p.ctaLabel}
              accent={p.accent}
              icon={p.icon}
              descriptor={p.descriptor}
              secondaryUrl={p.secondaryUrl}
              secondaryLabel={p.secondaryLabel}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="cases" id="cases">
      <div class="container">
        <h2 class="label reveal">Clientes e produtos</h2>
        <ul class="case-list reveal">
          {cases.map((c) => (
            <li class="case">
              <div class="case-top">
                {c.logo
                  ? <img class="case-logo" src={c.logo} alt={c.name} loading="lazy" />
                  : <span class="case-name">{c.name}</span>}
                <span class="case-tag">{c.tag}</span>
              </div>
              <p class="case-tagline">{c.tagline}</p>
              <p class="case-desc">{c.description}</p>
              {c.url && (
                <a class="case-link" href={c.url} target="_blank" rel="noopener noreferrer">
                  {c.ctaLabel}
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="ferramentas" id="ferramentas">
      <div class="container">
        <h2 class="label reveal">Outras ferramentas</h2>
        <ul class="tool-list reveal">
          {ferramentas.map((f) => (
            <li>
              <strong>{f.name}</strong>
              <span>{f.description}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="about" id="sobre">
      <div class="container">
        <h2 class="label reveal">Sobre</h2>
        <div class="about-body reveal">
          <p>
            Cada sistema acima foi feito ponta a ponta: banco de dados, backend, frontend e
            integração com os canais que os clientes já usam.
          </p>
          <p>
            O Grupo Viktus reúne os três produtos de software (Finanças, Care e Spaces);
            o resto é trabalho direto com clientes e negócios próprios.
          </p>
          <a href="/sobre" class="link-sobre">
            Dados da empresa e produtos Viktus
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .container {
    max-width: var(--max-width-editorial);
    margin: 0 auto;
  }

  /* ---------- hero ---------- */
  .hero { padding: var(--space-24) var(--space-6) var(--space-12); }

  /* A foto entra como assinatura, não como retrato: o assunto da página é o
     trabalho, e um rosto grande no topo rouba esse foco. */
  .byline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .avatar {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-pill);
    object-fit: cover;
    object-position: center 22%;
    border: 1px solid var(--color-border);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }
  .hero-copy .label { margin-bottom: var(--space-3); }

  .display {
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    font-weight: 500;
    line-height: var(--display-leading);
    letter-spacing: var(--display-tracking);
    text-wrap: balance;
  }
  .display em { font-style: normal; color: var(--color-text-faint); }

  .lede {
    margin-top: var(--space-4);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 48ch;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-12);
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .facts div { display: flex; flex-direction: column; gap: var(--space-1); }
  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .facts dd {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- produtos ---------- */
  .products { padding: var(--space-16) var(--space-6); }

  .grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }
  .grid--flat { grid-template-columns: repeat(3, 1fr); }

  /* ---------- cases ---------- */
  .cases { padding: var(--space-16) var(--space-6); border-top: 1px solid var(--color-border); }
  .case-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-4);
  }
  .case {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: border-color var(--dur-base) var(--ease), background var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }
  .case:hover {
    background: var(--color-surface-hover);
    border-color: rgba(242, 238, 227, 0.22);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .case { transition: none; }
    .case:hover { transform: none; }
  }
  .case-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    min-height: 34px;
    margin-bottom: var(--space-2);
  }
  /* Altura fixa iguala logos de proporções muito diferentes (a da Guri é 6:1,
     a da Conselhos é 2,4:1) sem distorcer nenhuma. */
  .case-logo { height: 30px; width: auto; max-width: 62%; object-fit: contain; }
  .case-name { font-weight: 600; font-size: 1.05rem; }
  .case-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    white-space: nowrap;
  }
  .case-tagline { color: var(--color-text-muted); font-size: 0.9rem; }
  .case-desc { color: var(--color-text-muted); font-size: 0.88rem; line-height: 1.6; margin-top: var(--space-1); }
  .case-link {
    margin-top: var(--space-2);
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    display: inline-flex;
    gap: var(--space-2);
  }
  .case-link:hover { gap: var(--space-3); }

  /* ---------- ferramentas ---------- */
  .ferramentas { padding: var(--space-12) var(--space-6); }
  .tool-list { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); max-width: 62ch; }
  .tool-list li { display: flex; flex-direction: column; gap: 2px; font-size: 0.9rem; }
  .tool-list strong { color: var(--color-text); }
  .tool-list span { color: var(--color-text-muted); line-height: 1.6; }

  /* ---------- sobre ---------- */
  .about { padding: var(--space-12) var(--space-6) var(--space-16); border-top: 1px solid var(--color-border); }
  .about-body { display: flex; flex-direction: column; gap: var(--space-4); }
  .about-body p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 62ch;
  }
  .link-sobre {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    transition: gap var(--dur-base) var(--ease);
  }
  .link-sobre:hover { gap: var(--space-4); opacity: 1; }

  @media (max-width: 860px) {
    .grid--flat { grid-template-columns: 1fr; }
    .hero { padding: var(--space-16) var(--space-6) var(--space-8); }
    .facts { gap: var(--space-6) var(--space-8); margin-top: var(--space-8); }
  }
</style>
