</style><script is:inline src="/vendor/gsap.min.js"></script><script is:inline>
(function(){
 if(!window.gsap||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
 var dp=document.querySelector('.dp');if(!dp)return;
 function explodeAssenta(h,k){function F(t){return t-Math.log(1+Math.exp(k*(t-h)))/k}var v0=1/(F(1)-F(0));
  return function(t){return t<=0?0:t>=1?1:(F(t)-F(0))*v0}}
 var ease=explodeAssenta(.5,10);
 var pRows=[].slice.call(dp.querySelectorAll('.papelada tbody tr'));
 var sRows=[].slice.call(dp.querySelectorAll('.tela tbody tr'));
 var chips=sRows.map(function(r){return r.querySelector('.st')});
 var tot=dp.querySelector('.tot'),nota=dp.querySelector('.r1');
 var acumulado=[0,0,862.40,1842.40,2062.30];
 function fmt(v){return 'A pagar R$ '+v.toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})}
 dp.style.position='relative';
 var tl=null,visivel=false;
 function limpar(){if(tl){tl.kill();tl=null}
  [].forEach.call(dp.querySelectorAll('.fantasma'),function(n){n.remove()});
  gsap.set(sRows.concat(chips,pRows,[nota]),{clearProps:'all'});tot.textContent=fmt(2062.30)}
 function montar(){
  limpar();
  var o=dp.getBoundingClientRect(),soma={v:0};
  tl=gsap.timeline({repeat:-1,paused:true});
  tl.set(sRows,{opacity:0,x:14},0).set(chips,{opacity:0,scale:.5},0).set(pRows,{opacity:1},0)
    .set(nota,{opacity:1,x:0,y:0,scale:1},0).set(soma,{v:0,onComplete:function(){tot.textContent=fmt(0)}},0);
  pRows.forEach(function(row,i){
   var a=row.getBoundingClientRect(),b=sRows[i].getBoundingClientRect(),t=.7+i*1.15;
   var g=document.createElement('div');g.className='fantasma';g.setAttribute('aria-hidden','true');
   g.textContent=[].map.call(row.cells,function(c){return c.textContent.trim()}).filter(Boolean).join('   ');
   dp.appendChild(g);
   tl.set(g,{left:a.left-o.left,top:a.top-o.top,width:a.width,height:a.height,opacity:0,rotate:-1.4},0)
     .to(row,{opacity:.18,duration:.25},t)
     .to(g,{opacity:1,duration:.12},t)
     .to(g,{left:b.left-o.left,top:b.top-o.top,width:b.width,height:b.height,rotate:0,
            backgroundColor:'#161C40',color:'#ECEBF4',duration:1.05,ease:ease},t)
     .to(g,{opacity:0,duration:.25},t+1)
     .to(sRows[i],{opacity:1,x:0,duration:.4,ease:'power3.out'},t+.95)
     .to(chips[i],{opacity:1,scale:1,duration:.45,ease:'power3.out'},t+1.15);
   if(acumulado[i]!==(i?acumulado[i-1]:0))
    tl.to(soma,{v:acumulado[i],duration:.7,ease:'power2.out',onUpdate:function(){tot.textContent=fmt(soma.v)}},t+1.1);
   if(i===2){var c=chips[2].getBoundingClientRect(),n=nota.getBoundingClientRect();
    tl.to(nota,{x:(c.left+c.width/2)-(n.left+n.width/2),y:(c.top+c.height/2)-(n.top+n.height/2),
                scale:.35,opacity:0,duration:1.05,ease:ease},t+.1)}
  });
  var fim=.7+pRows.length*1.15+1.2;
  tl.to(sRows,{opacity:0,x:-10,duration:.45,stagger:.06,ease:'power2.in'},fim+3.2)
    .to(pRows,{opacity:1,duration:.5},fim+3.3)
    .to(nota,{opacity:1,x:0,y:0,scale:1,duration:.6,ease:'power3.out'},fim+3.4)
    .set({},{},fim+4.4);
  if(visivel)tl.play();
 }
 new IntersectionObserver(function(es){visivel=es[0].isIntersecting;
  if(visivel){if(!tl)montar();else tl.play()}else if(tl)tl.pause()},{threshold:.35}).observe(dp);
 var espera;addEventListener('resize',function(){clearTimeout(espera);espera=setTimeout(function(){if(tl)montar()},250)});
})();
</script><script is:inline>
