      .passagem:hover,.passagem:focus-visible{border-color:var(--line-2);transform:translateY(-2px);
        background:linear-gradient(150deg,rgba(242,238,227,.09),rgba(242,238,227,.02))}
      .passagem__k{display:block;font-family:var(--display);font-size:.74rem;font-weight:600;
